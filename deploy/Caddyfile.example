# Example for a HOST-side Caddy only. Do not start alongside an existing Coolify 80/443 proxy.
# Container proxies cannot reach host 127.0.0.1 by using their own loopback.
k9m2x7p4vq3b8z1.12190529.xyz {
    @approvals path /approval /approval/*
    handle @approvals {
        reverse_proxy 127.0.0.1:18791 {
            header_up Host k9m2x7p4vq3b8z1.12190529.xyz
        }
    }
    @mcp path /mcp /oauth/* /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /health
    handle @mcp {
        reverse_proxy 127.0.0.1:18790 {
            header_up Host k9m2x7p4vq3b8z1.12190529.xyz
            flush_interval -1
        }
    }
    # Preserve the existing website's routes here if this domain already serves something.
    handle {
        respond "Not Found" 404
    }
    # No access log: OAuth URLs can contain transient authorization material.
}
