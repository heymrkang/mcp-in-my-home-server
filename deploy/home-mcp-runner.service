[Unit]
Description=Home MCP unprivileged isolated runner and task manager
Requires=home-mcp-runner.socket
After=home-mcp-runner.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=home-mcp-runner
Group=home-mcp-runner
WorkingDirectory=/opt/home-mcp/app
ExecStart=/usr/bin/python3 -B -m homemcp.runner
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
UMask=0077
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/mnt/storage/dev /var/lib/home-mcp-runner
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# Enables authenticated workspace network clients; other isolation remains.
PrivateNetwork=false
InaccessiblePaths=-/var/lib/home-mcp/private -/var/lib/home-mcp-owner -/var/lib/home-mcp-broker -/run/home-mcp-broker.sock -/var/run/docker.sock
ProtectControlGroups=true
ProtectKernelModules=true
# ProtectKernelLogs is intentionally omitted: Ubuntu 24.04 systemd
# proc masking prevents nested bwrap --proc mount (verified with systemd-run).
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
TasksMax=256
MemoryMax=2G
CPUQuota=200%
LimitNOFILE=1024
LimitFSIZE=268435456
# No docker/sudo/control groups. Payloads receive a separate syscall filter.
# Do not block user namespaces or the sandbox's own namespaced sysctls here.
